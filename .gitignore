# macOS
.DS_Store
._*

# Python, for scripts/dmg/background.py
__pycache__/
*.py[cod]

# emaki's own data, in case EMAKI_HOME ever points at the checkout.
# These hold real conversation transcripts — never commit them.
.emaki/
archive/
logs/
search.db
search.db-wal
search.db-shm
*.jsonl
emaki-export-*.html

# Editors
.idea/
.vscode/
*.swp
*~

# Rust. Build output at any depth: cargo run inside vendor/gpui-component,
# which is a workspace of its own, builds there. Its lock is not ours either:
# the one pin is the root Cargo.lock.
target/
/dist
/vendor/*/Cargo.lock
